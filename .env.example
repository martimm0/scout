# ---------------------------------------------------------------------------
# Everything here is OPTIONAL.
#
# With an empty .env, Scout runs in LOCAL MODE: the full game works, progress is
# saved to localStorage, and sign-in is hidden rather than shown-and-broken.
# Fill these in and sign-in plus cloud saves light up on their own.
# ---------------------------------------------------------------------------

# --- Google sign-in (Milestone 13) ---
# From https://console.cloud.google.com/apis/credentials
#   1. Create an OAuth 2.0 Client ID, type "Web application"
#   2. Authorised redirect URI (local):  http://localhost:3000/api/auth/callback/google
#   3. Authorised redirect URI (prod):   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Signing key for the session JWT. Generate one with:  npx auth secret
AUTH_SECRET=

# --- Database (Milestone 14) ---
# Vercel Postgres or Neon. On Vercel this is injected automatically when you
# attach a Postgres store, and you don't need to set it by hand.
# The table is created on first use; there is no migration step.
POSTGRES_URL=

# --- Optional ---
NEXT_PUBLIC_ASSET_BASE_URL=
